{
  "$description": "Tokens visuais do SendIt (direção Dark atlético). Fonte única: mobile/tailwind.config.js e mobile/src/constants/theme.ts replicam estes valores.",
  "color": {
    "bg": "#0A0D12",
    "surface": "#151B23",
    "surface-2": "#1E2530",
    "tab-bar": "#0F141B",
    "border": "#2E3744",
    "text": "#F1F5F9",
    "text-soft": "#C9D1DC",
    "muted": "#9AA4B2",
    "subtle": "#6B7586",
    "accent": "#22D37A",
    "accent-soft": "#4ADE95",
    "accent-ink": "#062814",
    "accent-tint": "#10301F",
    "danger": "#EF4444",
    "rpe-low": "#22D37A",
    "rpe-mid": "#F5B53D",
    "rpe-high": "#FF7A45"
  },
  "tier": {
    "cobre":     { "label": "Cobre",     "base": "#B5562E", "text": "#D2734A", "ink": "#2A1006", "gradient": ["#E08A5C", "#B5562E", "#7A3417"] },
    "bronze":    { "label": "Bronze",    "base": "#C9924A", "text": "#D9A962", "ink": "#2E1D06", "gradient": ["#F0CB8E", "#C9924A", "#8A5E25"] },
    "prata":     { "label": "Prata",     "base": "#C7CED8", "text": "#C7CED8", "ink": "#1F2630", "gradient": ["#F4F6F9", "#C7CED8", "#8C96A3"] },
    "ouro":      { "label": "Ouro",      "base": "#F2C230", "text": "#F2C230", "ink": "#3A2A00", "gradient": ["#FFF0B3", "#F2C230", "#B8860B"] },
    "platina":   { "label": "Platina",   "base": "#7FD6CF", "text": "#7FD6CF", "ink": "#0B2E2B", "gradient": ["#E3FBF8", "#7FD6CF", "#3E9A93"] },
    "diamante":  { "label": "Diamante",  "base": "#7CB8FF", "text": "#7CB8FF", "ink": "#0B2147", "gradient": ["#E0F0FF", "#7CB8FF", "#3B74C9"] },
    "esmeralda": { "label": "Esmeralda", "base": "#12B886", "text": "#34D399", "ink": "#03291D", "gradient": ["#A7F3D0", "#12B886", "#06664A"] },
    "mestre":    { "label": "Mestre",    "base": "#B794F6", "text": "#B794F6", "ink": "#24104F", "gradient": ["#E9DDFF", "#B794F6", "#6B46C1"] }
  },
  "font": {
    "display": { "family": "Barlow Condensed", "weights": [700], "use": "números, títulos, CTAs" },
    "body": { "family": "Outfit", "weights": [400, 500, 600, 700], "use": "texto, rótulos" }
  },
  "radius": {
    "card": 20,
    "button": 18,
    "control": 14,
    "pill": 999
  },
  "size": {
    "touch-min": 44,
    "stepper": 64,
    "cta-height": 60
  }
}
